generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleType {
  OPERATOR_ADMIN
  OPERATOR_MANAGER
  OPERATOR_STAFF
  OPERATOR_EXTERNAL
  TEAM_ADMIN
  TEAM_HEAD_COACH
  TEAM_COACH
  TEAM_EXTERNAL_COACH
  PLAYER
  PARENT
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          UserOrganization[]
  teams          Team[]
  calendarEvents CalendarEvent[]
  announcements  Announcement[]
}

model Team {
  id             String   @id @default(uuid())
  organizationId String
  parentId       String?
  name           String
  logoUrl        String?
  description    String?
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization     Organization @relation(fields: [organizationId], references: [id])
  parent           Team?        @relation("TeamHierarchy", fields: [parentId], references: [id])
  children         Team[]       @relation("TeamHierarchy")
  users            UserTeam[]
  players          Player[]
  evaluationItems  EvaluationItem[]
  evaluationRounds EvaluationRound[]
  invitations      Invitation[]
  goalCategories   GoalCategory[]
  teamCategories   TeamCategory[]
  calendarEvents   CalendarEvent[]
  announcements    Announcement[]
  joinRequests     TeamJoinRequest[]
  transfersFrom    TransferHistory[] @relation("TransferFromTeam")
  transfersTo      TransferHistory[] @relation("TransferToTeam")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  password     String
  name         String
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organizations        UserOrganization[]
  teams                UserTeam[]
  players              Player[]
  parentPlayers        PlayerParent[]
  evaluations          Evaluation[]
  playerNotes          PlayerNote[]
  calendarEvents       CalendarEvent[]
  announcements        Announcement[]
  appealLinks          AppealLink[]
  joinRequests         TeamJoinRequest[]
  reviewedRequests     TeamJoinRequest[] @relation("JoinRequestReviewer")
  notifications        Notification[]
  notificationSetting  NotificationSetting?
}

model UserOrganization {
  id             String   @id @default(uuid())
  userId         String
  organizationId String
  role           RoleType
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId, role])
}

model UserTeam {
  id        String   @id @default(uuid())
  userId    String
  teamId    String
  role      RoleType
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId, role])
}

model Player {
  id             String   @id @default(uuid())
  userId         String?
  teamId         String
  teamCategoryId String?
  name           String
  nameRomaji     String?
  number         String?
  position       String?
  birthDate      DateTime?
  height         Int?
  weight         Int?
  dominantFoot   String?
  hometown       String?
  school         String?
  previousTeam   String?
  photoUrl       String?
  passportUrl    String?
  roleModel      String?
  playStyle      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user             User?          @relation(fields: [userId], references: [id])
  team             Team           @relation(fields: [teamId], references: [id])
  teamCategory     TeamCategory?  @relation(fields: [teamCategoryId], references: [id])
  parents          PlayerParent[]
  evaluations      Evaluation[]
  appealLinks      AppealLink[]
  videos           Video[]
  teamHistory      PlayerTeamHistory[]
  notes            PlayerNote[]
  goals            Goal[]
  invitations      Invitation[]
  transferHistory  TransferHistory[]
}

model TeamCategory {
  id        String   @id @default(uuid())
  teamId    String
  name      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  team                          Team                          @relation(fields: [teamId], references: [id])
  players                       Player[]
  announcementCategoryTargets   AnnouncementCategoryTarget[]
  calendarEventCategoryTargets  CalendarEventCategoryTarget[]

  @@unique([teamId, name])
}

model PlayerParent {
  id        String   @id @default(uuid())
  playerId  String
  userId    String
  createdAt DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([playerId, userId])
}

model PlayerTeamHistory {
  id        String   @id @default(uuid())
  playerId  String
  teamId    String
  joinedAt  DateTime
  leftAt    DateTime?

  player Player @relation(fields: [playerId], references: [id])
}

model PlayerNote {
  id        String   @id @default(uuid())
  playerId  String
  authorId  String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id])
}

model EvaluationItem {
  id              String   @id @default(uuid())
  teamId          String
  parentId        String?
  name            String
  description     String?
  targetPositions String[] @default([])
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  team        Team             @relation(fields: [teamId], references: [id])
  parent      EvaluationItem?  @relation("ItemHierarchy", fields: [parentId], references: [id])
  children    EvaluationItem[] @relation("ItemHierarchy")
  evaluations Evaluation[]
}

model EvaluationRound {
  id        String   @id @default(uuid())
  teamId    String
  name      String
  startDate DateTime
  endDate   DateTime?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  team        Team         @relation(fields: [teamId], references: [id])
  evaluations Evaluation[]
}

model Evaluation {
  id          String   @id @default(uuid())
  playerId    String
  itemId      String
  roundId     String
  score       Int
  raterUserId String
  raterType   String
  evaluatedAt DateTime @default(now())

  player Player          @relation(fields: [playerId], references: [id])
  item   EvaluationItem  @relation(fields: [itemId], references: [id])
  round  EvaluationRound @relation(fields: [roundId], references: [id])
  rater  User            @relation(fields: [raterUserId], references: [id])
}

model Invitation {
  id          String    @id @default(uuid())
  teamId      String
  token       String    @unique
  email       String?
  playerName  String?
  playerId    String?
  role        RoleType
  expiresAt   DateTime
  usedAt      DateTime?
  createdBy   String?
  createdAt   DateTime  @default(now())

  team   Team    @relation(fields: [teamId], references: [id])
  player Player? @relation(fields: [playerId], references: [id])
}

model AppealLink {
  id                 String    @id @default(uuid())
  playerId           String
  token              String    @unique
  type               String
  comment            String?
  selfPrText         String?
  recommendationText String?
  displayConfig      Json?
  isActive           Boolean   @default(true)
  expiresAt          DateTime?
  createdBy          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt

  player  Player @relation(fields: [playerId], references: [id])
  creator User?  @relation(fields: [createdBy], references: [id])

  @@index([token])
}

model Video {
  id          String   @id @default(uuid())
  playerId    String?
  teamId      String?
  title       String
  description String?
  storageKey  String
  thumbnailUrl String?
  duration    Int?
  uploadedBy  String
  createdAt   DateTime @default(now())

  player Player? @relation(fields: [playerId], references: [id])
}

model GoalCategory {
  id          String   @id @default(uuid())
  teamId      String
  name        String
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  team  Team   @relation(fields: [teamId], references: [id])
  goals Goal[]
}

model Goal {
  id          String   @id @default(uuid())
  playerId    String
  categoryId  String
  content     String
  progress    Int?
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  player   Player       @relation(fields: [playerId], references: [id])
  category GoalCategory @relation(fields: [categoryId], references: [id])
}

model CalendarEvent {
  id          String   @id @default(uuid())
  teamId      String?
  organizationId String?
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime?
  allDay      Boolean  @default(false)
  eventType   String   @default("event")
  location    String?
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  team            Team?                        @relation(fields: [teamId], references: [id])
  organization    Organization?                @relation(fields: [organizationId], references: [id])
  author          User                         @relation(fields: [createdBy], references: [id])
  categoryTargets CalendarEventCategoryTarget[]
}

model CalendarEventCategoryTarget {
  id              String @id @default(uuid())
  calendarEventId String
  teamCategoryId  String

  calendarEvent CalendarEvent @relation(fields: [calendarEventId], references: [id], onDelete: Cascade)
  teamCategory  TeamCategory  @relation(fields: [teamCategoryId], references: [id], onDelete: Cascade)

  @@unique([calendarEventId, teamCategoryId])
}

model Announcement {
  id          String   @id @default(uuid())
  teamId      String?
  organizationId String?
  title       String
  content     String
  priority    String   @default("normal")
  isPublished Boolean  @default(true)
  publishedAt DateTime?
  expiresAt   DateTime?
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  team            Team?                        @relation(fields: [teamId], references: [id])
  organization    Organization?                @relation(fields: [organizationId], references: [id])
  author          User                         @relation(fields: [createdBy], references: [id])
  categoryTargets AnnouncementCategoryTarget[]
}

model AnnouncementCategoryTarget {
  id             String @id @default(uuid())
  announcementId String
  teamCategoryId String

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  teamCategory TeamCategory @relation(fields: [teamCategoryId], references: [id], onDelete: Cascade)

  @@unique([announcementId, teamCategoryId])
}

model TeamJoinRequest {
  id          String   @id @default(uuid())
  userId      String
  teamId      String
  playerName  String
  message     String?
  status      String   @default("pending")
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  team     Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  reviewer User? @relation("JoinRequestReviewer", fields: [reviewedBy], references: [id])

  @@unique([userId, teamId])
}

enum NotificationType {
  EVALUATION
  SELF_EVALUATION
  TASK
  VIDEO_COMMENT
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  linkUrl   String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}

model NotificationSetting {
  id                    String   @id @default(uuid())
  userId                String   @unique
  notifyEvaluation      Boolean  @default(true)
  notifySelfEvaluation  Boolean  @default(true)
  notifyTask            Boolean  @default(true)
  notifyComment         Boolean  @default(true)
  enableEmail           Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TransferHistory {
  id            String   @id @default(uuid())
  playerId      String
  fromTeamId    String
  toTeamId      String
  transferredAt DateTime @default(now())
  snapshotData  Json
  createdAt     DateTime @default(now())

  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  fromTeam Team   @relation("TransferFromTeam", fields: [fromTeamId], references: [id])
  toTeam   Team   @relation("TransferToTeam", fields: [toTeamId], references: [id])

  @@index([playerId])
  @@index([fromTeamId])
  @@index([toTeamId])
}

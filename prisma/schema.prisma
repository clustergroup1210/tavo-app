generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// RBAC Role Definitions
// ============================================
// Category A: Operations (Global Scope)
//   - SUPER_ADMIN: Full system access including settings and audit logs
//   - ADMIN: Team and user management capabilities
//   - OPERATOR: Most operations allowed, but no dangerous operations (hard delete)
//   - EXTERNAL: Read-only access to designated areas, limited evaluation
//
// Category B: Team (Team Scope)
//   - TEAM_MANAGER: Full team authority (create players, invite staff, evaluate)
//   - COACH: Evaluate assigned players, manage tasks/videos
//   - GUEST_COACH: Evaluate only explicitly assigned players
//
// Category C: User (Self Scope)
//   - PLAYER: View/edit own data only
//   - PARENT: View child's data only (no edit)
// ============================================

enum RoleType {
  // Operations (Global Scope)
  SUPER_ADMIN
  ADMIN
  OPERATOR
  EXTERNAL

  // Team (Team Scope)
  TEAM_MANAGER
  COACH
  GUEST_COACH

  // User (Self Scope)
  PLAYER
  PARENT
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          UserOrganization[]
  teams          Team[]
  calendarEvents CalendarEvent[]
  announcements  Announcement[]
}

model Team {
  id             String   @id @default(uuid())
  organizationId String
  parentId       String?
  name           String
  logoUrl        String?
  description    String?
  sortOrder      Int      @default(0)
  headCoachId    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization      Organization       @relation(fields: [organizationId], references: [id])
  parent            Team?              @relation("TeamHierarchy", fields: [parentId], references: [id])
  children          Team[]             @relation("TeamHierarchy")
  headCoach         User?              @relation("TeamHeadCoach", fields: [headCoachId], references: [id])
  users             UserTeam[]
  players           Player[]
  evaluationItems   EvaluationItem[]
  evaluationRounds  EvaluationRound[]
  invitations       Invitation[]
  goalCategories    GoalCategory[]
  teamCategories    TeamCategory[]
  calendarEvents    CalendarEvent[]
  announcements     Announcement[]
  joinRequests      TeamJoinRequest[]
  transfersFrom     TransferHistory[]  @relation("TransferFromTeam")
  transfersTo       TransferHistory[]  @relation("TransferToTeam")
  coachAssignments  CoachAssignment[]

  @@index([organizationId])
  @@index([parentId])
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  password     String
  name         String
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organizations        UserOrganization[]
  teams                UserTeam[]
  players              Player[]
  parentPlayers        PlayerParent[]
  evaluations          Evaluation[]
  playerNotes          PlayerNote[]
  calendarEvents       CalendarEvent[]
  announcements        Announcement[]
  appealLinks          AppealLink[]
  joinRequests         TeamJoinRequest[]
  reviewedRequests     TeamJoinRequest[] @relation("JoinRequestReviewer")
  notifications        Notification[]
  notificationSetting  NotificationSetting?
  headCoachTeams       Team[]             @relation("TeamHeadCoach")
  coachAssignments     CoachAssignment[]  @relation("CoachAssignee")
  videoComments        VideoComment[]
  assignedTasks        Task[]             @relation("TaskAssigner")
}

model UserOrganization {
  id             String   @id @default(uuid())
  userId         String
  organizationId String
  role           RoleType
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId, role])
  @@index([userId])
  @@index([organizationId])
  @@index([role])
  @@index([organizationId, role])
}

model UserTeam {
  id        String   @id @default(uuid())
  userId    String
  teamId    String
  role      RoleType
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId, role])
  @@index([userId])
  @@index([teamId])
  @@index([role])
  @@index([teamId, role])
  @@index([teamId, userId])
}

model Player {
  id             String   @id @default(uuid())
  userId         String?
  teamId         String
  teamCategoryId String?
  name           String
  nameRomaji     String?
  number         String?
  position       String?
  birthDate      DateTime?
  height         Int?
  weight         Int?
  dominantFoot   String?
  hometown       String?
  school         String?
  previousTeam   String?
  photoUrl       String?
  passportUrl    String?
  roleModel      String?
  playStyle      String?
  joinedAt       DateTime?
  graduationDate DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user             User?            @relation(fields: [userId], references: [id])
  team             Team             @relation(fields: [teamId], references: [id])
  teamCategory     TeamCategory?    @relation(fields: [teamCategoryId], references: [id])
  parents          PlayerParent[]
  evaluations      Evaluation[]
  appealLinks      AppealLink[]
  videos           Video[]
  teamHistory      PlayerTeamHistory[]
  notes            PlayerNote[]
  goals            Goal[]
  invitations      Invitation[]
  transferHistory  TransferHistory[]
  coachAssignments CoachAssignment[]
  tasks            Task[]

  @@index([teamId])
  @@index([userId])
  @@index([teamCategoryId])
  @@index([name])
}

model TeamCategory {
  id        String   @id @default(uuid())
  teamId    String
  name      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  team                          Team                          @relation(fields: [teamId], references: [id])
  players                       Player[]
  announcementCategoryTargets   AnnouncementCategoryTarget[]
  calendarEventCategoryTargets  CalendarEventCategoryTarget[]

  @@unique([teamId, name])
}

model PlayerParent {
  id        String   @id @default(uuid())
  playerId  String
  userId    String
  createdAt DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([playerId, userId])
}

model PlayerTeamHistory {
  id        String   @id @default(uuid())
  playerId  String
  teamId    String
  joinedAt  DateTime
  leftAt    DateTime?

  player Player @relation(fields: [playerId], references: [id])
}

model PlayerNote {
  id        String   @id @default(uuid())
  playerId  String
  authorId  String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id])

  @@index([playerId])
  @@index([authorId])
}

model EvaluationItem {
  id              String   @id @default(uuid())
  teamId          String
  parentId        String?
  name            String
  description     String?
  targetPositions String[] @default([])
  maxScore        Int      @default(5)
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  team        Team             @relation(fields: [teamId], references: [id])
  parent      EvaluationItem?  @relation("ItemHierarchy", fields: [parentId], references: [id])
  children    EvaluationItem[] @relation("ItemHierarchy")
  evaluations Evaluation[]

  @@index([teamId])
  @@index([parentId])
}

model EvaluationRound {
  id        String   @id @default(uuid())
  teamId    String
  name      String
  startDate DateTime
  endDate   DateTime?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  team        Team         @relation(fields: [teamId], references: [id])
  evaluations Evaluation[]

  @@index([teamId])
}

model Evaluation {
  id          String   @id @default(uuid())
  playerId    String
  itemId      String
  roundId     String
  score       Int
  raterUserId String
  raterType   String
  evaluatedAt DateTime @default(now())

  player Player          @relation(fields: [playerId], references: [id])
  item   EvaluationItem  @relation(fields: [itemId], references: [id])
  round  EvaluationRound @relation(fields: [roundId], references: [id])
  rater  User            @relation(fields: [raterUserId], references: [id])

  @@index([playerId])
  @@index([roundId])
  @@index([itemId])
  @@index([raterUserId])
  @@index([playerId, roundId])
}

model Invitation {
  id          String    @id @default(uuid())
  teamId      String
  token       String    @unique
  email       String?
  playerName  String?
  playerId    String?
  role        RoleType
  expiresAt   DateTime
  usedAt      DateTime?
  createdBy   String?
  createdAt   DateTime  @default(now())

  team   Team    @relation(fields: [teamId], references: [id])
  player Player? @relation(fields: [playerId], references: [id])

  @@index([teamId])
  @@index([expiresAt])
}

model AppealLink {
  id                 String    @id @default(uuid())
  playerId           String
  token              String    @unique
  type               String
  comment            String?
  selfPrText         String?
  recommendationText String?
  displayConfig      Json?
  isActive           Boolean   @default(true)
  expiresAt          DateTime?
  createdBy          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt

  player  Player @relation(fields: [playerId], references: [id])
  creator User?  @relation(fields: [createdBy], references: [id])

  @@index([token])
}

model Video {
  id          String   @id @default(uuid())
  playerId    String?
  teamId      String?
  title       String
  description String?
  storageKey  String
  thumbnailUrl String?
  duration    Int?
  uploadedBy  String
  createdAt   DateTime @default(now())

  player   Player?        @relation(fields: [playerId], references: [id])
  comments VideoComment[]

  @@index([playerId])
  @@index([uploadedBy])
  @@index([teamId])
}

model VideoComment {
  id        String   @id @default(uuid())
  videoId   String
  userId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([videoId])
  @@index([userId])
}

model Task {
  id          String    @id @default(uuid())
  playerId    String
  assignedBy  String
  title       String
  description String?
  dueDate     DateTime?
  status      TaskStatus @default(PENDING)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  assigner User   @relation("TaskAssigner", fields: [assignedBy], references: [id])

  @@index([playerId])
  @@index([assignedBy])
  @@index([status])
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model GoalCategory {
  id          String   @id @default(uuid())
  teamId      String
  name        String
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  team  Team   @relation(fields: [teamId], references: [id])
  goals Goal[]

  @@index([teamId])
}

model Goal {
  id          String   @id @default(uuid())
  playerId    String
  categoryId  String
  content     String
  progress    Int?
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  player   Player       @relation(fields: [playerId], references: [id])
  category GoalCategory @relation(fields: [categoryId], references: [id])

  @@index([playerId])
  @@index([categoryId])
}

model CalendarEvent {
  id          String   @id @default(uuid())
  teamId      String?
  organizationId String?
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime?
  allDay      Boolean  @default(false)
  eventType   String   @default("event")
  location    String?
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  team            Team?                        @relation(fields: [teamId], references: [id])
  organization    Organization?                @relation(fields: [organizationId], references: [id])
  author          User                         @relation(fields: [createdBy], references: [id])
  categoryTargets CalendarEventCategoryTarget[]

  @@index([teamId])
  @@index([organizationId])
  @@index([startDate])
}

model CalendarEventCategoryTarget {
  id              String @id @default(uuid())
  calendarEventId String
  teamCategoryId  String

  calendarEvent CalendarEvent @relation(fields: [calendarEventId], references: [id], onDelete: Cascade)
  teamCategory  TeamCategory  @relation(fields: [teamCategoryId], references: [id], onDelete: Cascade)

  @@unique([calendarEventId, teamCategoryId])
}

model Announcement {
  id          String   @id @default(uuid())
  teamId      String?
  organizationId String?
  title       String
  content     String
  priority    String   @default("normal")
  isPublished Boolean  @default(true)
  publishedAt DateTime?
  expiresAt   DateTime?
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  team            Team?                        @relation(fields: [teamId], references: [id])
  organization    Organization?                @relation(fields: [organizationId], references: [id])
  author          User                         @relation(fields: [createdBy], references: [id])
  categoryTargets AnnouncementCategoryTarget[]

  @@index([teamId])
  @@index([organizationId])
  @@index([isPublished])
  @@index([expiresAt])
}

model AnnouncementCategoryTarget {
  id             String @id @default(uuid())
  announcementId String
  teamCategoryId String

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  teamCategory TeamCategory @relation(fields: [teamCategoryId], references: [id], onDelete: Cascade)

  @@unique([announcementId, teamCategoryId])
}

model TeamJoinRequest {
  id          String   @id @default(uuid())
  userId      String
  teamId      String
  playerName  String
  message     String?
  status      String   @default("pending")
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  team     Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  reviewer User? @relation("JoinRequestReviewer", fields: [reviewedBy], references: [id])

  @@unique([userId, teamId])
}

enum NotificationType {
  EVALUATION
  SELF_EVALUATION
  TASK
  VIDEO_COMMENT
  CALENDAR
  ANNOUNCEMENT
  JOIN_REQUEST
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  linkUrl   String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}

model NotificationSetting {
  id                    String   @id @default(uuid())
  userId                String   @unique
  notifyEvaluation      Boolean  @default(true)
  notifySelfEvaluation  Boolean  @default(true)
  notifyTask            Boolean  @default(true)
  notifyComment         Boolean  @default(true)
  notifyCalendar        Boolean  @default(true)
  notifyAnnouncement    Boolean  @default(true)
  enableEmail           Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TransferHistory {
  id            String   @id @default(uuid())
  playerId      String
  fromTeamId    String
  toTeamId      String
  transferredAt DateTime @default(now())
  snapshotData  Json
  createdAt     DateTime @default(now())

  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  fromTeam Team   @relation("TransferFromTeam", fields: [fromTeamId], references: [id])
  toTeam   Team   @relation("TransferToTeam", fields: [toTeamId], references: [id])

  @@index([playerId])
  @@index([fromTeamId])
  @@index([toTeamId])
}

model CoachAssignment {
  id        String   @id @default(uuid())
  coachId   String
  playerId  String
  teamId    String
  createdAt DateTime @default(now())

  coach  User   @relation("CoachAssignee", fields: [coachId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([coachId, playerId])
  @@index([teamId])
  @@index([coachId])
  @@index([playerId])
}

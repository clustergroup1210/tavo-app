generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleType {
  OPERATOR_ADMIN
  OPERATOR_MANAGER
  OPERATOR_STAFF
  OPERATOR_EXTERNAL
  TEAM_ADMIN
  TEAM_HEAD_COACH
  TEAM_COACH
  TEAM_EXTERNAL_COACH
  PLAYER
  PARENT
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       UserOrganization[]
  teams       Team[]
}

model Team {
  id             String   @id @default(uuid())
  organizationId String
  parentId       String?
  name           String
  logoUrl        String?
  description    String?
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
  parent         Team?        @relation("TeamHierarchy", fields: [parentId], references: [id])
  children       Team[]       @relation("TeamHierarchy")
  users          UserTeam[]
  players        Player[]
  evaluationItems EvaluationItem[]
  evaluationRounds EvaluationRound[]
  invitations    Invitation[]
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  password     String
  name         String
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organizations UserOrganization[]
  teams         UserTeam[]
  players       Player[]
  parentPlayers PlayerParent[]
  evaluations   Evaluation[]
  playerNotes   PlayerNote[]
}

model UserOrganization {
  id             String   @id @default(uuid())
  userId         String
  organizationId String
  role           RoleType
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId, role])
}

model UserTeam {
  id        String   @id @default(uuid())
  userId    String
  teamId    String
  role      RoleType
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId, role])
}

model Player {
  id           String   @id @default(uuid())
  userId       String?
  teamId       String
  name         String
  nameRomaji   String?
  number       String?
  position     String?
  birthDate    DateTime?
  height       Int?
  weight       Int?
  dominantFoot String?
  hometown     String?
  school       String?
  previousTeam String?
  passportUrl  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user        User?          @relation(fields: [userId], references: [id])
  team        Team           @relation(fields: [teamId], references: [id])
  parents     PlayerParent[]
  evaluations Evaluation[]
  appealLinks AppealLink[]
  videos      Video[]
  teamHistory PlayerTeamHistory[]
  notes       PlayerNote[]
}

model PlayerParent {
  id        String   @id @default(uuid())
  playerId  String
  userId    String
  createdAt DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([playerId, userId])
}

model PlayerTeamHistory {
  id        String   @id @default(uuid())
  playerId  String
  teamId    String
  joinedAt  DateTime
  leftAt    DateTime?

  player Player @relation(fields: [playerId], references: [id])
}

model PlayerNote {
  id        String   @id @default(uuid())
  playerId  String
  authorId  String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id])
}

model EvaluationItem {
  id          String   @id @default(uuid())
  teamId      String
  parentId    String?
  name        String
  description String?
  position    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  team        Team             @relation(fields: [teamId], references: [id])
  parent      EvaluationItem?  @relation("ItemHierarchy", fields: [parentId], references: [id])
  children    EvaluationItem[] @relation("ItemHierarchy")
  evaluations Evaluation[]
}

model EvaluationRound {
  id        String   @id @default(uuid())
  teamId    String
  name      String
  startDate DateTime
  endDate   DateTime?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  team        Team         @relation(fields: [teamId], references: [id])
  evaluations Evaluation[]
}

model Evaluation {
  id          String   @id @default(uuid())
  playerId    String
  itemId      String
  roundId     String
  score       Int
  raterUserId String
  raterType   String
  evaluatedAt DateTime @default(now())

  player Player          @relation(fields: [playerId], references: [id])
  item   EvaluationItem  @relation(fields: [itemId], references: [id])
  round  EvaluationRound @relation(fields: [roundId], references: [id])
  rater  User            @relation(fields: [raterUserId], references: [id])
}

model Invitation {
  id        String   @id @default(uuid())
  teamId    String
  token     String   @unique
  email     String?
  role      RoleType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id])
}

model AppealLink {
  id          String   @id @default(uuid())
  playerId    String
  token       String   @unique
  type        String
  comment     String?
  isActive    Boolean  @default(true)
  createdBy   String?
  createdAt   DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id])
}

model Video {
  id          String   @id @default(uuid())
  playerId    String?
  teamId      String?
  title       String
  description String?
  storageKey  String
  thumbnailUrl String?
  duration    Int?
  uploadedBy  String
  createdAt   DateTime @default(now())

  player Player? @relation(fields: [playerId], references: [id])
}

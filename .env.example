# =============================================================================
# TAVO 環境変数サンプル
# 本番（AWS EC2）では `/var/www/tavo/.env` に配置し、systemd / PM2 から読み込む
# =============================================================================

# --- 基本 ---
NODE_ENV=production
PORT=5000
LOG_FORMAT=json
LOG_LEVEL=info
APP_URL=https://app.ta-vo.jp

# --- セキュリティ ---
JWT_SECRET=__change_me__長いランダム文字列__
COOKIE_DOMAIN=.ta-vo.jp

# --- データベース（AWS RDS PostgreSQL） ---
# 例: postgresql://USER:PASSWORD@xxxx.xxxxxxxx.ap-northeast-1.rds.amazonaws.com:5432/tavo?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@RDS_ENDPOINT:5432/tavo?sslmode=require

# --- AWS S3（アップロードファイル保存） ---
AWS_REGION=ap-northeast-1
S3_BUCKET=tavo-prod-uploads
# EC2 に IAM ロールを付与する場合は AWS_ACCESS_KEY_ID/SECRET は不要
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# CloudFront などを経由する場合に設定（任意）
# S3_PUBLIC_BASE_URL=https://cdn.ta-vo.jp

# --- Web Push 通知 ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@ta-vo.jp

# --- メール（パスワードリセット等、SES を利用する場合） ---
# MAIL_FROM=no-reply@ta-vo.jp
# SES_REGION=ap-northeast-1
